{
  "name": "dsh-invoice-ledger",
  "version": "0.1.4",
  "description": "核对发票台账：重复报销、价税勾稽、抬头、日期、模板占位符，输出异常清单与规范化台账。",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./batch": {
      "types": "./lib/batch.d.mts",
      "default": "./lib/batch.mjs"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "locale/*.json",
    "icon.svg",
    "rules",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs/assets/*",
    "samples",
    "TROUBLESHOOTING.md",
    "screenshots.json",
    "capability.json",
    "bin"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "check:lockfile": "node scripts/check-lockfile-drift.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm test && pnpm run build && pnpm run verify:self-contained && pnpm run check:lockfile && pnpm run check:citations",
    "prepare": "tsdown",
    "check:citations": "node scripts/check-citations.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input/invoices.csv",
      "prompt": "用自带样例核对一遍发票台账，告诉我发现了几条问题、分别是什么级别。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "发票台账（.csv）"
      ],
      "writes": [],
      "network": false,
      "external": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "invoice",
    "ledger",
    "reimbursement",
    "duplicate"
  ],
  "author": {
    "name": "PerryLink"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-invoice-ledger.git"
  },
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-invoice-ledger/issues"
  },
  "homepage": "https://github.com/PerryLink/dsh-invoice-ledger#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-0 <0.3.0"
  },
  "packageManager": "pnpm@11.7.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1 <0.2.0 || >=0.2.0-0 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-package-manifest": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.20.1",
    "vitest": "^3.2.7",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "tsdown": "^0.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "dsh-table-ingest": "^0.2.1"
  },
  "bin": {
    "dsh-invoice-batch": "bin/invoice-batch.mjs"
  }
}
